name:          cabal2obs
version:       0
synopsis:      Convert a set of Cabal files into an OBS project
description:   Convert a set of Cabal files into an OBS project. This tool is used mainly
               to generate
               <https://build.opensuse.org/project/show/devel:languages:haskell> and its
               sub-projects.
license:       GPL-3
license-file:  LICENSE
author:        Peter Simons, Ondřej Súkup
maintainer:    opensuse-haskell@opensuse.org
tested-with:   GHC == 9.12.2 || == 9.14.1
category:      Distribution
homepage:      https://github.com/opensuse-haskell/configuration
build-type:    Simple
cabal-version: 2.0
extra-source-files:
               tests/run-tests
               tests/spec-cleaner/*.spec.in
               tests/spec-cleaner/*.test
               tests/update-changes-file/*.test

source-repository head
  type:     git
  location: https://github.com/opensuse-haskell/cabal2obs

library
  exposed-modules:  ExtractVersionUpdates
                    MyCabal
                    UpdateChangesFile
  hs-source-dirs:   src/lib
  build-depends:    base                  >= 4.13 && < 5
                  , Cabal                 == 3.14.* || == 3.16.* || == 3.18.*
                  , directory
                  , distribution-opensuse ^>= 1.2
                  , extra
                  , pretty
                  , regex-posix
                  , shake
                  , text
                  , time
                  , turtle
  default-language: Haskell2010
  other-extensions: CPP
                    GeneralizedNewtypeDeriving
                    TypeFamilies
                    OverloadedStrings
                    DeriveGeneric
                    DeriveAnyClass

-- The raw configuration data: the package set, flags, compiler, etc. The
-- cabal2obs executable must not depend on this library; it accesses the
-- configuration only through config-oracles so that Shake can track it.
library config-data
  exposed-modules:  Config.Compiler
                    Config.Flags
                    Config.ForcedExecutables
                    Config.PackageSet
                    Config.Tools
                    Types
  hs-source-dirs:   src/config-data
  build-depends:    base, cabal2obs, containers, shake
  default-language: Haskell2010
  other-extensions: DeriveAnyClass
                    DeriveGeneric
                    OverloadedLists
                    OverloadedStrings

-- Shake oracles that give access to the configuration in config-data.
library config-oracles
  exposed-modules:  Oracle.Compiler
                    Oracle.Flags
                    Oracle.ForcedExecutables
                    Oracle.PackageSet
  reexported-modules: Types
  hs-source-dirs:   src/config-oracles
  build-depends:    base, cabal2obs, config-data, containers, shake
  default-language: Haskell2010
  other-extensions: GeneralizedNewtypeDeriving
                    TypeFamilies

executable cabal2obs
  main-is:          cabal2obs.hs
  other-modules:    Oracle
                    Oracle.Hackage
  hs-source-dirs:   src/cabal2obs
  build-depends:    base
                  , bytestring
                  , cabal2obs
                  , cabal2spec            ^>= 2.9.0
                    -- Access the configuration only through these oracles,
                    -- never directly through config-data.
                  , config-oracles
                  , containers
                  , directory
                  , distribution-opensuse
                  , extra
                  , shake                 >= 0.16
                  , tar                   > 0.6
                  , time
  default-language: Haskell2010
  other-extensions: CPP
                    GeneralizedNewtypeDeriving
                    TypeFamilies
                    OverloadedStrings
                    DeriveGeneric
                    DeriveAnyClass
  ghc-options:      -threaded -with-rtsopts=-qg -with-rtsopts=-qb

executable update-changes-file
  main-is:          update-changes-file.hs
  hs-source-dirs:   src/update-changes-file
  build-depends:    base, cabal2obs, optional-args, text, turtle
  default-language: Haskell2010
  other-extensions: CPP
                    GeneralizedNewtypeDeriving
                    TypeFamilies
                    OverloadedStrings
                    DeriveGeneric
                    DeriveAnyClass
  ghc-options:      -threaded

executable update-package-set
  main-is:          update-package-set.hs
  hs-source-dirs:   src/update-package-set
  build-depends:    base, cabal2obs, config-data, containers, nix-paths, pretty, shake
  default-language: Haskell2010
  other-extensions: OverloadedLists
                    OverloadedStrings
  ghc-options:      -threaded

test-suite regression-test
  type:             exitcode-stdio-1.0
  main-is:          regression-test.hs
  hs-source-dirs:   src/regression-test
  build-depends:    base, cabal2obs, text, time
  default-language: Haskell2010
  ghc-options:      -threaded
