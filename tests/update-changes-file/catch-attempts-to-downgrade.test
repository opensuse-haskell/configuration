###############################################################################
# Attempts to downgrade the version fail (without modifying the file)
###############################################################################

$$$ rm -f mtl.changes

$$$ cabal -v0 v2-run update-changes-file -- -t "Mon Jan  1 00:00:00 UTC 2024" mtl.changes mtl 2.2.2 0 joe@example.org
$$$ cat mtl.changes
>>>
-------------------------------------------------------------------
Mon Jan  1 00:00:00 UTC 2024 - joe@example.org

- Add mtl at version 2.2.2.

>>>= 0

$$$ cabal -v0 v2-run update-changes-file -- -t "Mon Jan  1 00:00:00 UTC 2024" mtl.changes mtl 1.0 0 joe@example.org
>>>2
update-changes-file: user error (mtl.changes: unsupported downgrade from version 2.2.2 to 1.0)
>>>= 1
$$$ cat mtl.changes
>>>
-------------------------------------------------------------------
Mon Jan  1 00:00:00 UTC 2024 - joe@example.org

- Add mtl at version 2.2.2.

>>>= 0
