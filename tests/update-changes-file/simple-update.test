###############################################################################
# Verify that new changelogs are created properly.
###############################################################################

$$$ rm -f mtl.changes

$$$ cabal -v0 v2-run update-changes-file -- -t "Mon Jan  1 00:00:00 UTC 2024" mtl.changes mtl 2.2 0 joe@example.org
>>>= 0

$$$ cat mtl.changes
>>>
-------------------------------------------------------------------
Mon Jan  1 00:00:00 UTC 2024 - joe@example.org

- Add mtl at version 2.2.

>>>= 0

###############################################################################
# Re-running the update with the same version has no effect.
###############################################################################

$$$ cabal -v0 v2-run update-changes-file -- -t "Mon Jan  1 00:00:00 UTC 2024" mtl.changes mtl 2.2 0 joe@example.org
>>>= 0

$$$ cat mtl.changes
>>>
-------------------------------------------------------------------
Mon Jan  1 00:00:00 UTC 2024 - joe@example.org

- Add mtl at version 2.2.

>>>= 0

###############################################################################
# Now let's try an update.
###############################################################################

$$$ cabal -v0 v2-run update-changes-file -- -t "Mon Jan  1 00:00:00 UTC 2024" mtl.changes mtl 2.2.0.1 0 joe@example.org
>>>= 0
$$$ cat mtl.changes
>>>
-------------------------------------------------------------------
Mon Jan  1 00:00:01 UTC 2024 - joe@example.org

- Update mtl to version 2.2.0.1.
  2.2.0.1
  -------
  * Fixed a bug caused by the change in how `transformers` 0.4 exports its data types. We will now export `runFooT` for each transformer again!

-------------------------------------------------------------------
Mon Jan  1 00:00:00 UTC 2024 - joe@example.org

- Add mtl at version 2.2.

>>>= 0
