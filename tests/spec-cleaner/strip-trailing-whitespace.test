###############################################################################
# cabal2obs relies on spec-cleaner to strip trailing whitespace from generated
# spec files, e.g. whitespace introduced by our patches. These tests add
# trailing whitespace to a spec file generated by cabal2obs, run spec-cleaner
# on it the same way cabal2obs does, and check that
#
#  - no trailing whitespace is left, and
#  - nothing else has changed, except possibly for blank lines (see below).
#
# The fixture ghc-happy-lib.spec.in has no trailing whitespace. The tests add
# it with sed while they run, because editors and commit hooks tend to strip
# trailing whitespace from files stored in the repository.
#
# Limitations:
#
#  - The tests don't add whitespace to the copyright header (lines 1-18). If
#    the header lines end in whitespace, spec-cleaner doesn't recognize the
#    header as the standard one and adds the "Please submit bugfixes or
#    comments" note a second time. The whitespace is still stripped, but the
#    result no longer matches the fixture. Our patches never touch the header,
#    so this case doesn't matter for cabal2obs.
#
#  - Two consecutive blank lines stay two when they are truly empty, but
#    spec-cleaner merges them into one when they contain whitespace. The tests
#    therefore compare the result to the fixture with "diff -B", which ignores
#    changes in blank lines. A change spec-cleaner makes only to blank lines
#    would go unnoticed.
###############################################################################

$$$ grep -c '[[:space:]]$' ghc-happy-lib.spec.in
>>>
0
>>>= 1

###############################################################################
# Trailing spaces
###############################################################################

$$$ sed -e '19,$s/$/   /' ghc-happy-lib.spec.in > ghc-happy-lib.spec && grep -c '[[:space:]]$' ghc-happy-lib.spec
>>>
122
>>>= 0

$$$ PYTHONPATH=../../src/spec-cleaner python3 -m spec_cleaner --suse-copyright --copyright-year=2026 -i ghc-happy-lib.spec && grep -c '[[:space:]]$' ghc-happy-lib.spec
>>>
0
>>>= 1

$$$ diff -u -B ghc-happy-lib.spec.in ghc-happy-lib.spec
>>>= 0

###############################################################################
# Trailing tabs and mixed whitespace
###############################################################################

$$$ sed -e '19,$s/$/ \t \t/' ghc-happy-lib.spec.in > ghc-happy-lib.spec && grep -c '[[:space:]]$' ghc-happy-lib.spec
>>>
122
>>>= 0

$$$ PYTHONPATH=../../src/spec-cleaner python3 -m spec_cleaner --suse-copyright --copyright-year=2026 -i ghc-happy-lib.spec && grep -c '[[:space:]]$' ghc-happy-lib.spec
>>>
0
>>>= 1

$$$ diff -u -B ghc-happy-lib.spec.in ghc-happy-lib.spec
>>>= 0

###############################################################################
# Lines that consist of whitespace only
###############################################################################

$$$ sed -e '19,$s/^$/  \t  /' ghc-happy-lib.spec.in > ghc-happy-lib.spec && grep -c '^[[:space:]]\+$' ghc-happy-lib.spec
>>>
27
>>>= 0

$$$ PYTHONPATH=../../src/spec-cleaner python3 -m spec_cleaner --suse-copyright --copyright-year=2026 -i ghc-happy-lib.spec && grep -c '[[:space:]]$' ghc-happy-lib.spec
>>>
0
>>>= 1

$$$ diff -u -B ghc-happy-lib.spec.in ghc-happy-lib.spec
>>>= 0

$$$ rm -f ghc-happy-lib.spec
